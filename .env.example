# Kopier til .env og fyll inn lokalt. Ikke legg ekte verdier i denne filen.

# Generelt
MEREDIA_ENV=development
LOG_LEVEL=INFO
LOG_DIR=logs
DATABASE_PATH=data/meredia.sqlite3

# LLM (research, scoring, personalisering, mailutkast)
LLM_API_KEY=

# E-post: Gmail via Google Workspace. Utsending er avslått til den settes til true manuelt.
EMAIL_PROVIDER=gmail
EMAIL_SENDING_ENABLED=false
EMAIL_SENDER_ADDRESS=
EMAIL_MAX_PER_DAY=10

# Gmail API (OAuth). Bruk minste privilegium.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
