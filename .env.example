# Kopier til .env og fyll inn lokalt. Ikke legg ekte verdier i denne filen.

# Generelt
MEREDIA_ENV=development
LOG_LEVEL=INFO
LOG_DIR=logs
DATABASE_PATH=data/meredia.sqlite3

# LLM (research, scoring, personalisering, mailutkast)
LLM_API_KEY=

# E-post: graph eller gmail. Utsending er avslått til den settes til true manuelt.
EMAIL_PROVIDER=
EMAIL_SENDING_ENABLED=false
EMAIL_SENDER_ADDRESS=
EMAIL_MAX_PER_DAY=10

# Microsoft Graph (kun hvis EMAIL_PROVIDER=graph). Bruk minste privilegium.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# Gmail (kun hvis EMAIL_PROVIDER=gmail)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
